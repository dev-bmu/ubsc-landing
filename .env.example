# ===== Proxy ke ubsc-api =====
# Dipakai rewrites() di next.config.ts untuk /api/* dan /uploads/*, dan jadi sumber
# images.remotePatterns. Hanya berlaku di dev — di produksi nginx yang menerminasi kedua path itu.
API_BASE_URL=http://localhost:4020

# ===== Situs publik =====
# Basis URL absolut untuk metadata (canonical, OpenGraph) dan sitemap.
# Produksi: https://ubsportcenter.co.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Zona waktu =====
# Seluruh tampilan tanggal dan jam operasional memakai waktu Jakarta.
TZ=Asia/Jakarta

# ===== Sinkronisasi kontrak (R12) =====
# Path lokal ke repo ubsc-api, dibaca `npm run sync:contracts` untuk menyalin shared/*.ts
# ke src/types/contracts/. Relatif terhadap root repo ini.
UBSC_API_LOCAL_PATH=../ubsc-api
