# ===== Proxy ke ubsc-api =====
# Tujuan rewrites() di next.config.ts untuk /api/* dan /uploads/* (dev dan produksi), dan sumber
# images.remotePatterns. Dibaca saat build. Produksi: http://127.0.0.1:4010
API_BASE_URL=http://localhost:4020

# ===== CDN media (ubsc-media + unggahan) =====
# Custom domain bucket R2 publik: video di luar git (reels/) dan gambar unggahan API (uploads/, diizinkan
# next/image). Kosong = '/assets' (rewrite dev ke API /media). Harus sama dengan R2_PUBLIC_URL API.
# Produksi: https://cdn.ubsportcenter.co.id
NEXT_PUBLIC_MEDIA_URL=

# ===== Situs publik =====
# Basis URL absolut untuk metadata (canonical, OpenGraph) dan sitemap.
# Produksi: https://ubsportcenter.co.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Zona waktu =====
# Seluruh tampilan tanggal dan jam operasional memakai waktu Jakarta.
TZ=Asia/Jakarta

# ===== Sinkronisasi kontrak (R12) =====
# Path lokal ke repo ubsc-api, dibaca `npm run sync:contracts` untuk menyalin shared/*.ts
# ke src/types/contracts/. Relatif terhadap root repo ini.
UBSC_API_LOCAL_PATH=../ubsc-api

# Rahasia bersama dengan LANDING_REVALIDATE_SECRET di ubsc-api (route POST /revalidate).
REVALIDATE_SECRET=
