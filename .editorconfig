# Menjaga file tetap LF walau ditulis dari Windows. Tanpa ini, skrip shell yang ikut repo
# akan tiba di server Linux dengan CRLF dan gagal: bad interpreter /bin/bash^M
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
