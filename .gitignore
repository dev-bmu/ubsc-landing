# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# R17: package-lock.json SENGAJA TIDAK di-ignore. Tanpa lockfile ter-commit, `npm ci` mustahil
# dan build jadi non-deterministik — persis yang menyembunyikan masalah resolve React 19 sampai produksi.
# Jangan menambahkan kembali barisnya.

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# R12: /src/types/contracts SENGAJA DI-COMMIT walau isinya AUTO-GENERATED oleh `npm run sync:contracts`.
# Build tidak boleh butuh akses ke repo ubsc-api, dan salinan yang ter-commit itulah yang membuat drift
# kontrak terlihat sebagai diff saat review. Jangan meng-ignore folder itu.
